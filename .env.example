# Copy this file to .env and fill in the two secrets. .env is gitignored.
# Docker Compose, the Spring Boot backend and Vite all read it.

# --- Database ---
POSTGRES_DB=galym
POSTGRES_USER=galym
# Generate with: openssl rand -hex 24
# Only read when the database is first created. To change it later, run
# `docker compose down -v` (this deletes the data) and start again.
POSTGRES_PASSWORD=change-me
# Where the backend finds the database when it runs outside Docker (./mvnw ...).
# Docker Compose publishes the database on port 5433 of this machine. Inside
# Docker this value is not used; the backend container talks to the db service.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/galym

# --- Backend ---
# Signs login tokens. Base64, at least 32 bytes, on one line.
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me
# The time zone that decides when a deadline day ends.
APP_TIMEZONE=Asia/Almaty
# Comma-separated list of frontend addresses allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend ---
# Where the browser reaches the backend.
VITE_API_URL=http://localhost:8080
