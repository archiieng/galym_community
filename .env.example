# Copy this file to .env and fill in the two secrets. .env is gitignored.
# Docker Compose, the Spring Boot backend and Vite all read it.

# --- Database ---
POSTGRES_DB=galym
POSTGRES_USER=galym
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# --- Backend ---
# Signs login tokens. Base64, at least 32 bytes. Generate with: openssl rand -base64 64
JWT_SECRET=change-me
# Comma-separated list of frontend addresses allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend ---
# Where the browser reaches the backend.
VITE_API_URL=http://localhost:8080
